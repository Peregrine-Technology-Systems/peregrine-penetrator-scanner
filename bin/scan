#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'json'
require_relative '../lib/penetrator'

options = {}

OptionParser.new do |opts|
  opts.banner = 'Usage: bin/scan [options]'
  opts.on('-p', '--profile PROFILE', 'Scan profile (quick/standard/thorough)') { |v| options[:profile] = v }
  opts.on('-n', '--name NAME', 'Target name') { |v| options[:target_name] = v }
  opts.on('-u', '--urls URLS', 'Target URLs (JSON array)') { |v| options[:urls] = JSON.parse(v) }
  opts.on('-h', '--help', 'Show help') { puts opts; exit }
end.parse!

Penetrator.boot!
Penetrator.boot_services!

# Stamp the VM's boot image (from the GCE metadata server) so audit events and
# status.json carry it for version traceability (#951). Fail-safe to "unknown"
# off-GCE; set once here so every downstream audit event sees it.
ENV['BOOT_IMAGE'] ||= InstanceMetadata.boot_image

if Bus::AdapterEnv.enabled?
  # Real deployment shape (scanner#1171, matching analyzer#243/tp-monitor#733):
  # a persistent poll-loop worker. The VM pulls its own scan.requested subject
  # directly (no launcher hand-off, #1152), runs one job per pull, and
  # idle-exits cleanly once tp-monitor's fleet has nothing left for it.
  worker_loop = Bus::WorkerLoop.new
  trap('TERM') { worker_loop.drain! }
  worker_loop.run
else
  # Off-bus: local dev, CI, the smoke-test harness — single-shot, CLI/ENV-driven
  # (scanner#1106's pre-bus launch path, unchanged).

  # Bus job pointer (scanner#1124): built for the launcher-hands-off model
  # tp-monitor#733 superseded — left as a harmless no-op fallback (the pointer
  # file will simply never exist under the restored pull-based model) pending
  # a follow-up cleanup issue rather than removing it here.
  job_detail = Bus::JobPointerResolver.new.resolve
  if job_detail
    ENV['SCAN_UUID'] ||= job_detail['job_id']
    ENV['TRANSACTION_ID'] ||= job_detail['transaction_id']
    ENV['ENVIRONMENT'] ||= job_detail['environment']
  end

  profile = ENV.fetch('SCAN_PROFILE', options[:profile] || 'standard')
  target_name = ENV.fetch('TARGET_NAME', options[:target_name] || 'Default Target')
  target_urls = JSON.parse(ENV.fetch('TARGET_URLS', (options[:urls] || ['http://localhost:8080']).to_json))

  result = ScanJobRunner.new(profile:, target_name:, target_urls:).call
  exit(result.passed ? 0 : 1) if %w[smoke smoke-test].include?(profile)
end
