#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'json'
require_relative '../lib/penetrator'

options = {}

OptionParser.new do |opts|
  opts.banner = 'Usage: bin/scan [options]'
  opts.on('-p', '--profile PROFILE', 'Scan profile (quick/standard/thorough)') { |v| options[:profile] = v }
  opts.on('-n', '--name NAME', 'Target name') { |v| options[:target_name] = v }
  opts.on('-u', '--urls URLS', 'Target URLs (JSON array)') { |v| options[:urls] = JSON.parse(v) }
  opts.on('-h', '--help', 'Show help') { puts opts; exit }
end.parse!

Penetrator.boot!
Penetrator.boot_services!

# Bus request (scanner#1106, restored by #1152): the fleet controller
# reversed the interim launcher-consumes-and-hands-off model that PR #1117
# was built against — the canonical worker contract is now "the worker pulls,
# processes, and acks its own subject directly." The VM pulls its own
# scan.requested claim-check here, taking precedence over ENV/CLI. Disabled
# (nil) until infra wires BUS_BUCKET/BUS_KEYSET_PATH + a live transport, so
# this is inert until the substrate is live; the ENV-injected VM-metadata path
# below stays the fallback.
bus_request = Bus::ScanRequestConsumer.new.next_request
bus_payload = Bus::ScanRequestPayload.new(bus_request)
ENV['SCAN_UUID'] ||= bus_payload.job_id
ENV['TRANSACTION_ID'] ||= bus_payload.transaction_id
ENV['ENVIRONMENT'] ||= bus_payload.environment

# Bus job pointer (scanner#1124): built for the now-superseded launcher-hands-
# off model — the launcher no longer hands the VM a claim-check pointer once
# the VM consumes its own subject directly (above). Left as a harmless no-op
# fallback (the pointer file will simply never exist under the restored model)
# pending a follow-up cleanup issue rather than mixing that removal into #1152.
job_detail = Bus::JobPointerResolver.new.resolve
if job_detail
  ENV['SCAN_UUID'] ||= job_detail['job_id']
  ENV['TRANSACTION_ID'] ||= job_detail['transaction_id']
  ENV['ENVIRONMENT'] ||= job_detail['environment']
end

# Bus request takes precedence over ENV, which takes precedence over CLI flags.
profile = bus_payload.profile || ENV.fetch('SCAN_PROFILE', options[:profile] || 'standard')
target_name = bus_payload.target_name || ENV.fetch('TARGET_NAME', options[:target_name] || 'Default Target')
target_urls = bus_payload.target_urls ||
              JSON.parse(ENV.fetch('TARGET_URLS', (options[:urls] || ['http://localhost:8080']).to_json))

# Stamp the VM's boot image (from the GCE metadata server) so audit events and
# status.json carry it for version traceability (#951). Fail-safe to "unknown"
# off-GCE; set once here so every downstream audit event sees it.
ENV['BOOT_IMAGE'] ||= InstanceMetadata.boot_image

puts '=== Web Application Penetration Test ==='
puts "Profile: #{profile}"
puts "Target: #{target_name}"
puts "URLs: #{target_urls.join(', ')}"
puts "Started: #{Time.current}"
puts '=' * 40

# Find or create target
target = Target.find_or_create(name: target_name) { |t| t.urls = target_urls }

# Create scan
scan = Scan.create(target_id: target.id, profile: profile)
puts "Scan ID: #{scan.id}"

audit = AuditLogger.new
audit.scan_started(scan)

# Execute scan
orchestrator = ScanOrchestrator.new(scan)
orchestrator.execute

# Smoke-test profile: export results to GCS (for CI verification) then exit fast
if %w[smoke smoke-test].include?(profile)
  puts "\n--- Smoke Test Export ---"
  gcs_path = ScanResultsExporter.new(scan).export
  puts "  Exported to #{gcs_path}"
  audit.scan_completed(scan, gcs_path: gcs_path)

  scan.refresh
  status = scan.status == 'completed' ? 'PASSED' : 'FAILED'
  puts "\n=== Smoke Test #{status} ==="
  exit(scan.status == 'completed' ? 0 : 1)
end

# Export versioned JSON to GCS
puts "\n--- Scan Results Export ---"
exporter = ScanResultsExporter.new(scan)
gcs_scan_results_path = exporter.export
puts "  Exported v#{ScanResultsExporter::SCHEMA_VERSION} to #{gcs_scan_results_path}"
audit.json_exported(scan, gcs_path: gcs_scan_results_path)

# Write completion status to GCS — the consumer polls this to detect completion
# (#906: GCS-only completion; ScanCallbackService removed). Enriched with the bus
# envelope identity (#1009) so the durable fallback carries transaction_id/trace id.
identity = ScanIdentity.from_env(scan_id: scan.id)
scan_uuid = identity.scan_uuid
StorageService.new.upload_json("control/#{scan_uuid}/status.json", {
  phase: 'completed',
  timestamp: Time.now.utc.iso8601,
  results_path: gcs_scan_results_path,
  boot_image: ENV.fetch('BOOT_IMAGE', InstanceMetadata::UNKNOWN)
}.merge(identity.to_h.except(:scan_uuid)))
puts "\n--- Completion Status ---"
puts "  Written control/#{scan_uuid}/status.json (results_path: #{gcs_scan_results_path})"

# Publish the bus completion event (#1009): a claim-check pointer to the report
# blob, never the bytes. Inert until the bus substrate is wired at deploy; the GCS
# status.json above stays the orchestrator's durable fallback.
ScanCompletionPublisher.new(scan, exporter:, identity:).emit
puts '  Published scan completion to the bus (no-op while the substrate is unwired)'

# Audit: scan completed
audit.scan_completed(scan, gcs_path: gcs_scan_results_path)

# Summary
scan.refresh
summary = scan.summary || {}
puts "\n=== Scan Complete ==="
puts "Duration: #{scan.duration&.to_i}s"
puts "Total Findings: #{summary['total_findings']}"
(summary['by_severity'] || {}).each do |sev, count|
  puts "  #{sev}: #{count}"
end
puts '=' * 40
