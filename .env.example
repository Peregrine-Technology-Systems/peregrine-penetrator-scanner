# Scan Configuration
SCAN_PROFILE=standard
TARGET_NAME=Example Target
TARGET_URLS=["https://example.com"]

# Output / storage
# GCS bucket for scan output + control/ artifacts. Empty → local-disk fallback.
# The GCP project is resolved from Application Default Credentials / the GCE
# metadata server (there is no GOOGLE_CLOUD_PROJECT env var in the runtime).
GCS_BUCKET=

# Logging
# json → one JSON object per line for Cloud Logging (the baked default on scan
# VMs); anything else → human-readable. LOG_LEVEL defaults to INFO.
LOG_FORMAT=
LOG_LEVEL=INFO

# Scan identity / lifecycle (normally injected by the org-native launcher)
SCAN_UUID=
SCAN_MODE=
SCAN_TIMEOUT=3600
JOB_ID=

# Optional HTTP heartbeat/callback (legacy transport; removed at bus cutover)
CALLBACK_URL=
SCAN_CALLBACK_SECRET=

# NOTE: this scanner is a headless probe-runner. It has NO Slack, SMTP/email,
# AI (Anthropic), or CVE-API (NVD) integration — those were extracted to other
# services. Scan-lifecycle events are emitted to GCS (control/<uuid>/status.json)
# and the bus (peregrine_bus claim-check), not to a notifier.
